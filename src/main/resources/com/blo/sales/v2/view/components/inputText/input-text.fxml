<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>

<fx:root type="VBox" xmlns:fx="http://javafx.com/fxml"
	spacing="4.0">

	<stylesheets>
		<URL value="@input-text.css" />
	</stylesheets>

	<!-- Título o etiqueta superior del input -->
	<Label fx:id="lblTitle" text="Campo" styleClass="input-text__title" />

	<!-- Campo de texto principal con estilos modernos -->
	<TextField fx:id="textField" promptText="Escribe aquí..." styleClass="input-text__field" />

	<!-- Mensaje de error (oculto por defecto) -->
	<Label fx:id="lblError" text="" visible="false" managed="false" styleClass="input-text--error" />

</fx:root>