<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.layout.VBox?>

<fx:root type="VBox" xmlns:fx="http://javafx.com/fxml" spacing="4.0">
    
    <!-- Título o etiqueta superior del input -->
    <Label fx:id="pwdTitle" text="Contraseña" 
           style="-fx-font-weight: bold; -fx-text-fill: #374151; -fx-font-size: 12px;"/>
    
    <!-- Campo de texto principal con estilos modernos -->
    <PasswordField fx:id="passwordField" promptText="********" 
               style="-fx-background-radius: 6px; -fx-border-radius: 6px; -fx-border-color: #d1d5db; -fx-padding: 8px;"/>
    
    <!-- Mensaje de error (oculto por defecto) -->
    <Label fx:id="lblError" text="" 
           style="-fx-text-fill: #dc2626; -fx-font-size: 11px;" 
           visible="false" managed="false"/>

</fx:root>