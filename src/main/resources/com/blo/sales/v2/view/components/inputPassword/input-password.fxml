<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.layout.VBox?>

<fx:root type="VBox" xmlns:fx="http://javafx.com/fxml"
	spacing="4.0">

	<stylesheets>
		<URL value="@input-password.css" />
	</stylesheets>

	<!-- Título o etiqueta superior del input -->
	<Label fx:id="pwdTitle" text="Contraseña" styleClass="input-password__title" />

	<!-- Campo de texto principal con estilos modernos -->
	<PasswordField fx:id="passwordField" promptText="********" styleClass="input-password__field" />

	<!-- Mensaje de error (oculto por defecto) -->
	<Label fx:id="lblError" text="" style="" visible="false" managed="false" styleClass="input-password--error" />

</fx:root>